# Copy this file to ".env" and fill in what you need. Everything is optional -
# each feature has an offline fallback.

# --- database (MySQL / MariaDB from WAMP) ---
# WAMP default: user "root" with an EMPTY password. The database is created automatically.
# If WAMP's MySQL runs on another port (e.g. 3307), change DB_PORT.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careerai

# --- core ---
SECRET_KEY=replace-with-a-long-random-secret

# --- email (verification + password reset). Without SMTP the links are
#     printed in the terminal and shown on screen in dev mode. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CareerAI <no-reply@example.com>
APP_BASE_URL=http://127.0.0.1:5000

# --- LLM (Resume Improver + Mock Interview) - pick ONE ---
# Anthropic
ANTHROPIC_API_KEY=
# or any OpenAI-compatible API (OpenAI / Groq / Gemini / Ollama)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# --- live jobs (free key from https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# --- semantic matching: auto | sbert | lite ---
SEMANTIC_BACKEND=auto


ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-password